SECRET_KEY=change-me-in-local-development-use-at-least-fifty-chars
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
# Vercel: config.settings.vercel; select preview, staging or production explicitly.
COFFEE_ENVIRONMENT=staging
POSTGRES_USER=coffee
POSTGRES_PASSWORD=coffee
POSTGRES_DB=coffee
# Host `db` is the docker-compose service name. For native run use localhost.
DATABASE_URL=postgres://coffee:coffee@db:5432/coffee
# Vercel: Neon pooled URL with ?sslmode=require, only for the isolated test DB.
# Manual migration operator only: direct Neon URL with ?sslmode=require.
# Do not install DATABASE_URL_UNPOOLED into the function runtime.
DATABASE_URL_UNPOOLED=
# Hosted backend: exact hostname(s), CORS: exact frontend origin(s).
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5174
# Hosted Django admin: exact HTTPS backend/admin and frontend origins as needed.
CSRF_TRUSTED_ORIGINS=
# Media: local filesystem for development; persistent public bucket for hosting.
MEDIA_STORAGE=filesystem
SERVE_MEDIA=False
# Required when MEDIA_STORAGE=s3. Server-only credentials; never expose via VITE_*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# Optional for AWS S3; required for most S3-compatible providers.
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# auto, path or virtual. Neon Object Storage uses path.
AWS_S3_ADDRESSING_STYLE=auto
# Optional public CDN ASCII hostname only (no scheme, path or trailing slash).
# Without it, public URLs use the S3 endpoint and bucket.
AWS_S3_CUSTOM_DOMAIN=
# See docs/media-storage.md. Seed runs only via explicit manage.py seed_catalog.
# X-Cart-Token is allowed/exposed via CORS_ALLOW_HEADERS / CORS_EXPOSE_HEADERS
# in config/settings/base.py (needed for the guest cart from the Vite SPA).

# YooKassa — create a demo store in https://yookassa.ru Merchant Profile,
# copy shopId / secret key here (never commit real values).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Vercel staging only: explicit test shop opt-in. Keep False in Preview.
YOOKASSA_STAGING_TEST_ENABLED=False
YOOKASSA_RETURN_URL=http://localhost:5174/checkout/result
# In ЛК: Integration → HTTP notifications → https://<public-host>/api/payments/webhook/
# (use ngrok/cloudflared when developing on localhost).
# Default is True (see settings). For local curl debugging only, set:
# YOOKASSA_WEBHOOK_IP_CHECK=False
