SECRET_KEY=change-me-in-local-development-use-at-least-fifty-chars
DEBUG=True
POSTGRES_USER=coffee
POSTGRES_PASSWORD=coffee
POSTGRES_DB=coffee
# Host `db` is the docker-compose service name. For native run use localhost.
DATABASE_URL=postgres://coffee:coffee@db:5432/coffee
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
# X-Cart-Token is allowed/exposed via CORS_ALLOW_HEADERS / CORS_EXPOSE_HEADERS
# in config/settings/base.py (needed for the guest cart from the Vite SPA).

# YooKassa — create a demo store in https://yookassa.ru Merchant Profile,
# copy shopId / secret key here (never commit real values).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5173/checkout/result
# In ЛК: Integration → HTTP notifications → https://<public-host>/api/payments/webhook/
# (use ngrok/cloudflared when developing on localhost).
# Set False only for local curl debugging; keep True in production.
YOOKASSA_WEBHOOK_IP_CHECK=False
